# @monorise-team/* pochodzą z GitHub Packages (ADR-0087). Token: zmienna GITHUB_PACKAGES_TOKEN
# (lokalnie `export GITHUB_PACKAGES_TOKEN=$(gh auth token)` po `gh auth refresh -s read:packages`, w CI token automatu).
@monorise-team:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_PACKAGES_TOKEN}
