{
  "name": "@timotime/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "TimoTime na telefon: Expo (iOS, Android)",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --localhost",
    "ios": "expo start --localhost --ios",
    "android": "expo start --localhost --android",
    "build": "expo export --platform ios --output-dir dist",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@monorise-team/sdk": "0.0.1-dev.20",
    "@monorise-team/tokens": "0.0.1-dev.20",
    "@timotime/client": "workspace:*",
    "expo": "~58.0.26",
    "expo-auth-session": "~58.0.19",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@monorise-team/config": "0.0.1-dev.20",
    "@types/react": "^19.3.0",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3"
  }
}
