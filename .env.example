# Przykładowe zmienne środowiskowe dla apps/web (lokalnie plik apps/web/.env.local tworzy `pnpm setup:env`).
# Nigdy nie commituj prawdziwych sekretów.

# Baza PostgreSQL (rola aplikacji timo_time_app z wymuszonym RLS)
DATABASE_URL=postgresql://timo_time_app:timo_time_app@localhost:5435/timo_time

# Adresy TimoTime (strona/API oraz aplikacja w przeglądarce)
TIMOTIME_API_URL=http://time.localhost:3300
TIMOTIME_APP_URL=http://timo-time.localhost:3300
# Opcjonalnie: lista hostów aplikacji oddzielona przecinkami
# TIMOTIME_APP_HOSTS=timo-time.monorise.studio,timo-time.localhost
# Opcjonalnie: dodatkowe originy CORS dla API
# TIMOTIME_ALLOWED_ORIGINS=

# Logowanie i integracja z MonoriseCore (ADR-0095)
CORE_AUTH_URL=http://localhost:3100
CORE_API_URL=http://localhost:3200
TIMOTIME_OAUTH_CLIENT_ID=timotime-web
# Sekret klienta z `pnpm oauth:seed` w MonoriseCore
TIMOTIME_OAUTH_CLIENT_SECRET=
# Klucz szyfrujący ciasteczka sesji BFF (co najmniej 32 znaki; przy wymianie „nowy,stary”)
TIMOTIME_SESSION_SECRET=

# Kanał zdarzeń Core (ms; 0 wyłącza; domyślnie 5000 w development, 0 poza nim)
# TIMOTIME_EVENT_FEED_INTERVAL_MS=5000

# Zadanie przypomnień e-mail o czasie pracy (ms; 0 wyłącza; domyślnie 300000 = co 5 minut)
TIMOTIME_REMINDERS_INTERVAL_MS=300000
