{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["TIMOTIME_TEST_DATABASE_URL", "TIMOTIME_TEST_APP_DATABASE_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@timotime/db#typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "@timotime/db#lint": {
      "dependsOn": ["^build", "build"]
    }
  }
}
