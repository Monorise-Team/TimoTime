    "/api/v1/time/start": {
      "post": {
        "tags": [
          "Time"
        ],
        "operationId": "startTimeEntry",
        "summary": "Rozpoczęcie nowego wpisu czasu pracy",
        "description": "Otwiera nowy wpis czasu pracy wybranego rodzaju (`WORK`, `BREAK`, `REMOTE`, `BUSINESS_TRIP`). Jeśli osoba ma już otwarty wpis, najpierw zamyka go w tej samej transakcji. Równoczesne wywołania startu bez otwartego wpisu zwracają `409 CONFLICT`. Wymaga dostępu do produktu `timotime` i uprawnienia `timotime.entries.write_own`.",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Rodzaj nowego wpisu oraz opcjonalna notatka (do 500 znaków).",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartTimeEntryInput"
