{
  "openapi": "3.1.0",
  "info": {
    "title": "TimoTime API",
    "version": "0.0.0",
    "summary": "API ewidencji czasu pracy TimoTime: rejestracja własnego czasu pracy, widok zespołu i stan usługi.",
    "description": "Opis API TimoTime (`/api/v1/*`) wygenerowany automatycznie z kodu (katalog ścieżek i schematy Zod). Wszystkie odpowiedzi ustawiają nagłówek `Cache-Control: no-store` i używają koperty `{ data, meta, error }` (ADR-0044). Tożsamość osoby i firmy zawsze wynika z tokenu albo sesji MonoriseCore (ADR-0037). Trasy `entries` są zapytaniami zakresowymi po przedziale dat [from, to] (maksymalnie 31 dni) i nie używają stronicowania kursorowego.",
    "license": {
      "name": "Proprietary, all rights reserved",
      "identifier": "LicenseRef-Proprietary"
    }
  },
  "servers": [
    {
      "url": "http://time.localhost:3300",
      "description": "Lokalnie"
    },
    {
      "url": "https://time.monorise.studio",
      "description": "Produkcja"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Stan usługi TimoTime."
    },
    {
      "name": "Session",
      "description": "Dane zalogowanej osoby, firmy i możliwości widoczne w przeglądarce (BFF)."
    },
    {
      "name": "Time",
      "description": "Rejestracja i odczyt własnych wpisów czasu pracy."
    },
    {
      "name": "Team",
      "description": "Widok kierownika: bieżący status i wpisy zespołu w zakresie uprawnień."
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "getHealth",
        "summary": "Stan usługi TimoTime",
        "description": "Publiczna kontrola zdrowia serwera API bez sprawdzania bazy danych i MonoriseCore.",
        "responses": {
          "200": {
            "description": "Usługa działa.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "Wewnętrzny błąd serwera (INTERNAL).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "Session"
        ],
        "operationId": "getMe",
        "summary": "Zalogowana osoba, firma i możliwości w TimoTime",
        "description": "Zwraca profil osoby i firmy pobrany z MonoriseCore (`GET /core/v1/me`) oraz pole `capabilities` wyliczone z migawki uprawnień produktu `timotime`. Dostępne wyłącznie przez sesję BFF przeglądarki (ciasteczko); aplikacja mobilna z tokenem Bearer otrzymuje `403 PERMISSION_DENIED`, bo pobiera profil bezpośrednio z Core API.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profil zalogowanej osoby, firma i możliwości w interfejsie.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Brak albo nieważny token dostępu albo wygasła sesja (UNAUTHENTICATED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Brak dostępu do produktu albo brak uprawnienia (PERMISSION_DENIED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Wewnętrzny błąd serwera (INTERNAL).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Usługa zależna (MonoriseCore) chwilowo niedostępna (INTERNAL).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/team/current": {
      "get": {
