    "/api/v1/team/entries": {
      "get": {
        "tags": [
          "Team"
        ],
        "operationId": "listTeamTimeEntries",
        "summary": "Wpisy czasu pracy zespołu w przedziale dat",
        "description": "Zapytanie zakresowe (bez stronicowania kursorowego): zwraca wpisy czasu pracy pracowników z zakresu uprawnienia `timotime.entries.read` nakładające się na przedział [from, to] (maksymalnie 31 dni, domyślnie dzisiejszy dzień w UTC), łącznie ze zmianami nocnymi i wpisami otwartymi. Wymaga dostępu do produktu `timotime` i uprawnienia `timotime.entries.read`.",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Początek przedziału dat w formacie ISO 8601 (YYYY-MM-DD lub pełny znacznik czasu UTC). Domyślnie początek dzisiejszego dnia w UTC; maksymalna rozpiętość przedziału to 31 dni.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "Koniec przedziału dat w formacie ISO 8601 (YYYY-MM-DD lub pełny znacznik czasu UTC). Domyślnie koniec dzisiejszego dnia w UTC; data końcowa nie może być wcześniejsza niż początkowa.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Wpisy czasu pracy zespołu oraz wyliczone granice przedziału [from, to].",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamTimeEntriesListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Brak albo nieważny token dostępu albo wygasła sesja (UNAUTHENTICATED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Brak dostępu do produktu albo brak uprawnienia (PRODUCT_ACCESS_REQUIRED, PERMISSION_DENIED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Błędne dane wejściowe (VALIDATION_FAILED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Wewnętrzny błąd serwera (INTERNAL).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Usługa zależna (MonoriseCore) chwilowo niedostępna (INTERNAL).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
