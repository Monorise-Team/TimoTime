              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamCurrentListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Brak albo nieważny token dostępu albo wygasła sesja (UNAUTHENTICATED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Brak dostępu do produktu albo brak uprawnienia (PRODUCT_ACCESS_REQUIRED, PERMISSION_DENIED).",
            "content": {
