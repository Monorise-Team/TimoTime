// Baza timo_time (ADR-0096): wpisy czasu pracy i sesje przeglądarki.
// Osoba, pracownik i firma pochodzą z MonoriseCore (sub, employee_id i org_id z tokenu), więc TimoTime nie ma własnych kont.
// Schemat "auth": sesje przeglądarki (BFF, @monorise-team/auth). Szukamy ich po skrócie identyfikatora z ciasteczka,
// zanim wiadomo, czyja to sesja, więc są bez RLS; tokeny w środku są zaszyfrowane.
// Schemat "public": wpisy czasu pracy z RLS po firmie, osobie i zakresie zespołu (migracje). Aplikacja łączy się rolą
// timo_time_app bez uprawnień właściciela tabel (ADR-0037).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth"]
}

/// Sesja przeglądarki: tokeny z Core zaszyfrowane po stronie serwera (ADR-0050).
model Session {
  /// SHA-256 identyfikatora z ciasteczka; samego identyfikatora baza nie zna.
  id             String   @id
  /// Konto Monorise (sub z tokenu Core).
  accountId      String   @map("account_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  /// Zaszyfrowane tokeny, kontekst firmy i dane osoby.
  data           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([accountId])
  @@index([expiresAt])
  @@map("sessions")
  @@schema("auth")
}

enum TimeEntryKind {
  WORK
  BREAK
  REMOTE
  BUSINESS_TRIP

  @@map("time_entry_kind")
  @@schema("public")
}

/// Wpis czasu pracy pracownika. Jedna osoba może mieć co najwyżej jeden otwarty wpis (indeks częściowy w migracji).
model TimeEntry {
  id             String        @id @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  /// Konto Monorise osoby (sub z tokenu Core).
  accountId      String        @map("account_id") @db.Uuid
  /// Pracownik w MonoriseCore (employee_id z tokenu Core).
  employeeId     String        @map("employee_id") @db.Uuid
  kind           TimeEntryKind
  startedAt      DateTime      @map("started_at") @db.Timestamptz(3)
  endedAt        DateTime?     @map("ended_at") @db.Timestamptz(3)
  note           String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([organizationId, accountId, startedAt])
  @@index([organizationId, employeeId, startedAt])
  @@map("time_entries")
  @@schema("public")
}

/// Kursor ostatnio przetworzonego zdarzenia z kanału HTTP produktu (bez danych firmowych, bez RLS).
model EventFeedCursor {
  /// Nazwa kanału zdarzeń, np. "core".
  id        String   @id
  /// Numer ostatnio przetworzonego zdarzenia (liczba dziesiętna jako napis).
  sequence  String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("event_feed_cursors")
  @@schema("public")
}

/// Zapis przetworzonych zdarzeń do deduplikacji po stronie odbiorcy (bez danych firmowych, bez RLS).
model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @map("processed_at") @db.Timestamptz(3)

  @@id([consumer, eventId])
  @@index([processedAt])
  @@map("processed_events")
  @@schema("public")
}
